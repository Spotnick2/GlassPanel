package-as: GlassPanel

enable-nolib-creation: no

# One CurseForge project, one addon folder per plugin (#7). WoW only
# discovers addons as top-level folders under Interface/AddOns, so plugins
# cannot ship nested inside GlassPanel/: the packager moves them out
# (AltStable's pattern). The destination is the plugin's TOC name.
# Add a line here with each new Plugins/<Name>; tests/test_toc.lua checks.
move-folders:
  GlassPanel/Plugins/XP: GlassPanelXP
  GlassPanel/Plugins/Gold: GlassPanelGold
  GlassPanel/Plugins/Clock: GlassPanelClock
  GlassPanel/Plugins/Durability: GlassPanelDurability
  GlassPanel/Plugins/Bags: GlassPanelBags
  GlassPanel/Plugins/PvP: GlassPanelPvP
  GlassPanel/Plugins/Guild: GlassPanelGuild
  GlassPanel/Plugins/Professions: GlassPanelProfessions
  GlassPanel/Plugins/Currencies: GlassPanelCurrencies
  GlassPanel/Plugins/Role: GlassPanelRole
  GlassPanel/Plugins/Layer: GlassPanelLayer
  GlassPanel/Plugins/GearScore: GlassPanelGearScore
  GlassPanel/Plugins/AltStable: GlassPanelAltStable
  GlassPanel/Plugins/Warlock: GlassPanelWarlock
  GlassPanel/Plugins/Reagents: GlassPanelReagents
  GlassPanel/Plugins/Ammo: GlassPanelAmmo
  GlassPanel/Plugins/Combat: GlassPanelCombat

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

# The glass material, embedded in the core only (plugins depend on the core).
# Pinned, never `tag: latest` (the packager picks the newest tag by creation
# date and falls back to the branch HEAD). Bump the pin only in a release made
# anyway: players get library fixes earlier through whichever glass addon
# ships the newest copy, since LibStub runs that one. CI reads the pin from
# here, so it is written once.
#
# No comment on a value line: the packager's YAML reader keeps it as part of
# the value.
externals:
  Libs/LibGlass-1.0:
    url: https://github.com/Spotnick2/LibGlass
    tag: r11

# YAML list, not markdown bullets. Every pattern matches the WHOLE path from
# the package root, so the top-level names below never reach inside Libs/.
ignore:
  - .github
  - .claude
  - docs
  - tests
  - Tools
  - CLAUDE.md
  - README.md
  - CHANGELOG.md
  # The library's own .pkgmeta ignores these, but CurseForge's packager, which
  # builds the release, doesn't apply an external's list (Priestly #53). So
  # they are named from here. Libs/LibGlass-1.0/LICENSE ships (MIT).
  - Libs/LibGlass-1.0/tests
  - Libs/LibGlass-1.0/docs
  - Libs/LibGlass-1.0/Tools
  - Libs/LibGlass-1.0/AGENTS.md
  - Libs/LibGlass-1.0/CLAUDE.md
  - Libs/LibGlass-1.0/README.md
