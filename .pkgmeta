package-as: GlassPanel

enable-nolib-creation: no

# One CurseForge project, one addon folder per plugin (#7). WoW only
# discovers addons as top-level folders under Interface/AddOns, so plugins
# cannot ship nested inside GlassPanel/: the packager moves them out
# (AltStable's pattern). The destination is the plugin's TOC name.
# Add a line here with each new Plugins/<Name>; tests/test_toc.lua checks.
move-folders:
  GlassPanel/Plugins/XP: GlassPanelXP
  GlassPanel/Plugins/Gold: GlassPanelGold
  GlassPanel/Plugins/Clock: GlassPanelClock
  GlassPanel/Plugins/Durability: GlassPanelDurability
  GlassPanel/Plugins/Bags: GlassPanelBags
  GlassPanel/Plugins/PvP: GlassPanelPvP
  GlassPanel/Plugins/Guild: GlassPanelGuild
  GlassPanel/Plugins/Professions: GlassPanelProfessions
  GlassPanel/Plugins/Role: GlassPanelRole
  GlassPanel/Plugins/Layer: GlassPanelLayer
  GlassPanel/Plugins/GearScore: GlassPanelGearScore

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

# YAML list, not markdown bullets.
ignore:
  - .github
  - .claude
  - docs
  - tests
  - Tools
  - CLAUDE.md
  - README.md
  - CHANGELOG.md
